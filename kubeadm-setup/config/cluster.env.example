# =============================================================================
# CKNE Hands-On Practice — cluster environment configuration
#
# Copy this file to cluster.env and adjust values as needed:
#
#   cp kubeadm-setup/config/cluster.env.example kubeadm-setup/config/cluster.env
#
# cluster.env is git-ignored and must never be committed. All scripts under
# kubeadm-setup/ source this file (via kubeadm-setup/common.sh's
# load_cluster_env, or lib/validation.sh) before touching AWS or the cluster.
# =============================================================================

# --- AWS region / placement -------------------------------------------------
AWS_REGION="eu-west-2"
AWS_AVAILABILITY_ZONE="eu-west-2a"

# --- Project / tagging -------------------------------------------------------
# Every AWS resource created by these scripts is tagged with these values.
# Teardown and status scripts ONLY ever act on resources carrying all four
# tags below — never on name pattern matches.
PROJECT_NAME="ckne-hands-on"
RESOURCE_PREFIX="ckne-lab"
TAG_PROJECT="CKNEHandsOn"
TAG_ENVIRONMENT="Training"
TAG_MANAGED_BY="AWSCliScripts"
TAG_RESOURCE_SET="ckne-lab"

# --- Networking ---------------------------------------------------------------
VPC_CIDR="10.0.0.0/16"
SUBNET_CIDR="10.0.1.0/24"

# --- Control plane node -------------------------------------------------------
CONTROL_PLANE_NAME="ckne-control-plane"
CONTROL_PLANE_INSTANCE_TYPE="t3.large"

# --- Worker nodes ---------------------------------------------------------------
WORKER_NAME_PREFIX="ckne-worker"
WORKER_INSTANCE_TYPE="t3.large"
WORKER_COUNT="2"

# --- Root volume ---------------------------------------------------------------
ROOT_VOLUME_SIZE="30"
ROOT_VOLUME_TYPE="gp3"

# --- Kubernetes -----------------------------------------------------------------
KUBERNETES_VERSION="v1.35"
POD_CIDR="10.244.0.0/16"
SERVICE_CIDR="10.96.0.0/12"

# --- Admin / access control ------------------------------------------------------
# CIDR allowed to reach the API server (6443) and, if ENABLE_SSH=true, port 22.
# Leave empty to disable both externally-reachable admin paths — in that case
# use `aws ssm start-session` / the bootstrap scripts' SSM Run Command path for
# everything, and `download-kubeconfig.sh` (also over SSM) to get kubectl access.
# Example: ALLOWED_ADMIN_CIDR="203.0.113.4/32"
ALLOWED_ADMIN_CIDR=""

# Node access defaults to AWS Systems Manager Session Manager (no key pair,
# no open port 22). Only set ENABLE_SSH=true if you explicitly want a
# fallback SSH path, and only ever alongside ALLOWED_ADMIN_CIDR — SSH is never
# opened to 0.0.0.0/0 by these scripts.
ENABLE_SSH="false"
# Name of an EXISTING EC2 key pair to attach when ENABLE_SSH=true. Never store
# the matching .pem file in this repository (.gitignore blocks *.pem anyway).
EC2_KEY_NAME=""

# --- NodePort admin access (optional) ---------------------------------------
# CIDR allowed to reach NodePort range (30000-32767) from outside the cluster
# security group, e.g. for reaching a lab Service from your laptop. Leave
# empty to keep NodePort reachable only from within the cluster security group.
ALLOWED_NODEPORT_CIDR=""
